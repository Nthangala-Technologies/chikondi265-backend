FROM node:22-bookworm-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.26.1 --activate

COPY . .

RUN pnpm install --frozen-lockfile --filter @workspace/api-server...
RUN pnpm --filter @workspace/api-server run build
RUN pnpm --filter @workspace/api-server deploy --prod --legacy /prod

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
ENV PORT=80
WORKDIR /app

COPY --from=build --chown=node:node /prod/ ./
COPY --from=build --chown=node:node /workspace/artifacts/api-server/dist/ ./dist/

USER node
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 80) + '/api/healthz').then((r) => { if (!r.ok) process.exit(1); }).catch(() => process.exit(1))"

CMD ["node", "--enable-source-maps", "dist/index.mjs"]
