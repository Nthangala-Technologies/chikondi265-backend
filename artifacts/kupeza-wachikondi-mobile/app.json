{
  "expo": {
    "name": "Chikondi265 App",
    "slug": "kupeza-wachikondi",
    "owner": "symon265",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Chikondi265 uses your camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "Chikondi265 accesses your photos so you can choose a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Chikondi265 saves photos you capture to your library."
      }
    },
    "android": {
      "package": "com.anonymous.kupezawachikondimobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon_2.png",
      "output": "static"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
